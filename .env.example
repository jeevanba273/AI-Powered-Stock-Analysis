# ============================================================
# NeuraStock Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# ----- Frontend (baked into Vite build) -----
# IndianAPI key for client-side (used as fallback, prefer server-side)
VITE_INDIAN_API_KEY=your-indian-api-key-here

# OpenAI key for client-side (optional, not currently used client-side)
VITE_OPENAI_API_KEY=

# ----- Server-side API Keys (never exposed to browser) -----
# IndianAPI key used by the Express proxy server
INDIAN_API_KEY=your-indian-api-key-here

# OpenAI API key for GPT-4o-mini (AI analysis + sentiment)
OPENAI_API_KEY=your-openai-api-key-here

# ----- Authentication -----
# Login credentials (single user)
AUTH_USERNAME=your-username

# Generate with: node -e "require('bcryptjs').hash('yourpassword', 10, (e,h) => console.log(h))"
AUTH_PASSWORD_HASH=$2b$10$your-bcrypt-hash-here

# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-random-64-byte-hex-secret
