
# Example environment variables - create a .env file with your actual keys

# Frontend (baked into build)
VITE_INDIAN_API_KEY=your-indian-api-key-here
VITE_OPENAI_API_KEY=your-openai-api-key-here

# Server-side auth (never exposed to browser)
AUTH_USERNAME=your-username
AUTH_PASSWORD_HASH=$2b$10$your-bcrypt-hash-here
JWT_SECRET=your-random-64-byte-hex-secret
